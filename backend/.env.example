PORT=4000
NODE_ENV=development

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

DATABASE_URL="file:./dev.db"

CORS_ORIGIN=http://localhost:5173

UPLOAD_DIR=uploads
