PORT=4000
NODE_ENV=development

# Generate one: openssl rand -base64 64 (single line, never commit a real secret)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Neon Postgres (Neon dashboard > Connection Details)
# DATABASE_URL = pooled connection (runtime) — host contains "-pooler"
# DIRECT_URL   = direct connection (migrations) — same host without "-pooler"
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@ep-xxx.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Local dev: http://localhost:5173
# Production (Render): https://bovipulse.vercel.app — comma-separate multiple origins, no trailing slash
CORS_ORIGIN=http://localhost:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

THERMAL_FEVER_THRESHOLD_C=39.5

INFERENCE_URL=http://localhost:8000

REPRO_GUARD_ENABLED=true
ESTRUS_ACTIVITY_MIN=60
ESTRUS_TEMP_MAX=40.3
CALVING_LOW_TEMP=37.5
LAMENESS_ACTIVE_START=5
LAMENESS_ACTIVE_END=20
